{
  "comp": {
    "button": {
      "bg-default": {
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
        "$value": "{color.black}"
      },
      "bg-hover": {
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
        "$value": "{color.grey}"
      },
      "fg": {
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
        "$value": "{color.white}"
      },
      "b-rad": {
        "$extensions": {
          "com.figma.scopes": [
            "CORNER_RADIUS"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "number",
        "$value": "{number.8}"
      },
      "v-pad": {
        "$extensions": {
          "com.figma.scopes": [
            "GAP"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "number",
        "$value": "{number.8}"
      },
      "h-pad": {
        "$extensions": {
          "com.figma.scopes": [
            "GAP"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "number",
        "$value": "{number.16}"
      },
      "min-h": {
        "$extensions": {
          "com.figma.scopes": [
            "WIDTH_HEIGHT"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "number",
        "$value": "56"
      }
    }
  }
}