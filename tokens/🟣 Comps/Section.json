{
  "comp": {
    "section": {
      "lg": {
        "h-pad": {
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "number",
          "$value": "{modify.screen.number.number.sm}"
        },
        "v-pad": {
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "number",
          "$value": "{modify.screen.number.number.lg}"
        }
      },
      "md": {
        "h-pad": {
          "$type": "number",
          "$value": "{modify.screen.number.number.sm}"
        },
        "v-pad": {
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "number",
          "$value": "{modify.screen.number.number.sm}"
        },
        "height": {
          "$extensions": {
            "com.figma.scopes": [
              "GAP"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "number",
          "$value": "{input.number.80}"
        }
      }
    }
  }
}