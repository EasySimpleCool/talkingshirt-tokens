{
  "comp": {
    "button": {
      "bg-default": {
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
        "$value": "{output.color.accent}"
      },
      "bg-hover": {
        "$extensions": {
          "com.figma.scopes": [
            "FRAME_FILL"
          ],
          "com.figma.hiddenFromPublishing": false,
          "studio.tokens": {
            "modify": {
              "type": "lighten",
              "value": "0.1",
              "space": "lch"
            }
          }
        },
        "$type": "color",
        "$value": "{output.color.accent}"
      },
      "fg": {
        "$extensions": {
          "com.figma.scopes": [
            "TEXT_FILL",
            "SHAPE_FILL"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
        "$value": "{output.color.on-accent}"
      },
      "b-rad": {
        "$extensions": {
          "com.figma.scopes": [
            "CORNER_RADIUS"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "number",
        "$value": "{input.number.8}"
      },
      "v-pad": {
        "$extensions": {
          "com.figma.scopes": [
            "GAP"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "number",
        "$value": "{input.number.8}"
      },
      "h-pad": {
        "$extensions": {
          "com.figma.scopes": [
            "GAP"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "number",
        "$value": "{input.number.16}"
      },
      "min-h": {
        "$extensions": {
          "com.figma.scopes": [
            "WIDTH_HEIGHT"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "number",
        "$value": "56"
      }
    }
  }
}