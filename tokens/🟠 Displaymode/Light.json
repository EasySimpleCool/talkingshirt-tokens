{
  "modify": {
    "displaymode": {
      "color": {
        "fg": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "{input.color.black}"
        },
        "bg": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "{input.color.white}"
        }
      }
    }
  }
}