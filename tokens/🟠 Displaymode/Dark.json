{
  "modify": {
    "displaymode": {
      "color": {
        "fg": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "{input.color.white}"
        },
        "bg": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "{input.color.black}"
        },
        "faint": {
          "$extensions": {
            "com.figma.scopes": [
              "ALL_SCOPES"
            ],
            "com.figma.hiddenFromPublishing": false,
            "studio.tokens": {
              "modify": {
                "type": "lighten",
                "value": "0.1",
                "space": "lch"
              }
            }
          },
          "$type": "color",
          "$value": "{input.color.black}"
        },
        "accent": {
          "$extensions": {
            "com.figma.scopes": [
              "FRAME_FILL",
              "TEXT_FILL"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "{input.color.white}"
        },
        "on-accent": {
          "$extensions": {
            "com.figma.scopes": [
              "TEXT_FILL",
              "SHAPE_FILL"
            ],
            "com.figma.hiddenFromPublishing": false
          },
          "$type": "color",
          "$value": "{input.color.black}"
        }
      },
      "number": {
        "faint": {
          "$type": "number",
          "$value": 0.9
        }
      }
    }
  }
}