{
  "modify": {
    "displaymode": {
      "color": {
        "fg": {
          "primary": {
            "$extensions": {
              "com.figma.scopes": [
                "ALL_SCOPES"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{color.white}"
          },
          "secondary": {
            "$extensions": {
              "com.figma.scopes": [
                "ALL_SCOPES"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{color.grey-3}"
          }
        },
        "bg": {
          "default": {
            "$extensions": {
              "com.figma.scopes": [
                "ALL_SCOPES"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{color.black}"
          },
          "alt": {
            "$extensions": {
              "com.figma.scopes": [
                "ALL_SCOPES"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{color.grey}"
          }
        },
        "stroke": {
          "default": {
            "$extensions": {
              "com.figma.scopes": [
                "STROKE_COLOR"
              ],
              "com.figma.hiddenFromPublishing": false
            },
            "$type": "color",
            "$value": "{color.grey}"
          }
        }
      }
    }
  }
}