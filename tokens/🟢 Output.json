{
  "theme": {
    "fg": {
      "$extensions": {
        "com.figma.scopes": [
          "SHAPE_FILL",
          "TEXT_FILL"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "color",
      "$value": "{color.black}"
    },
    "bg": {
      "$extensions": {
        "com.figma.scopes": [
          "ALL_FILLS"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "color",
      "$value": "{color.white}"
    },
    "faint": {
      "$extensions": {
        "com.figma.scopes": [
          "SHAPE_FILL",
          "TEXT_FILL"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "color",
      "$value": "{color.grey-2}"
    },
    "fg-alt": {
      "$extensions": {
        "com.figma.scopes": [
          "SHAPE_FILL",
          "TEXT_FILL"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "color",
      "$value": "{color.grey}"
    },
    "faint-alt": {
      "$extensions": {
        "com.figma.scopes": [
          "STROKE_COLOR"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "color",
      "$value": "{color.grey-3}"
    }
  },
  "text": {
    "medium": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_FAMILY",
          "FONT_STYLE",
          "FONT_SIZE",
          "LINE_HEIGHT",
          "LETTER_SPACING"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.inter}",
        "fontWeight": "{font-weight.bold}",
        "fontSize": "{number.24}",
        "lineHeight": "{line-height.normal}",
        "letterSpacing": "{number.0}"
      }
    },
    "small": {
      "$extensions": {
        "com.figma.scopes": [
          "FONT_FAMILY",
          "FONT_STYLE",
          "FONT_SIZE",
          "LINE_HEIGHT",
          "LETTER_SPACING"
        ],
        "com.figma.hiddenFromPublishing": false
      },
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.inter}",
        "fontWeight": "{font-weight.medium}",
        "fontSize": "{number.12}",
        "lineHeight": "{line-height.normal}",
        "letterSpacing": "{number.0}"
      }
    }
  }
}