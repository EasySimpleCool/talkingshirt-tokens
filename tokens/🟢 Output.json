{
  "output": {
    "color": {
      "fg": {
        "$extensions": {
          "com.figma.scopes": [
            "SHAPE_FILL",
            "TEXT_FILL"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
        "$value": "{modify.displaymode.color.fg}"
      },
      "fg-alt": {
        "$extensions": {
          "com.figma.scopes": [
            "SHAPE_FILL",
            "TEXT_FILL"
          ],
          "com.figma.hiddenFromPublishing": false,
          "studio.tokens": {
            "modify": {
              "type": "alpha",
              "value": ".5",
              "space": "lch"
            }
          }
        },
        "$type": "color",
        "$value": "{modify.displaymode.color.fg}"
      },
      "bg": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_FILLS"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "color",
        "$value": "{modify.displaymode.color.bg}"
      },
      "bg-alt": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_FILLS"
          ],
          "com.figma.hiddenFromPublishing": false,
          "studio.tokens": {
            "modify": {
              "type": "alpha",
              "value": "0.5",
              "space": "lch"
            }
          }
        },
        "$type": "color",
        "$value": "{modify.displaymode.color.bg}"
      },
      "faint": {
        "$extensions": {
          "com.figma.scopes": [
            "SHAPE_FILL",
            "TEXT_FILL",
            "STROKE_COLOR"
          ],
          "com.figma.hiddenFromPublishing": false,
          "studio.tokens": {
            "modify": {
              "type": "alpha",
              "value": "0.1",
              "space": "lch"
            }
          }
        },
        "$type": "color",
        "$value": "{modify.displaymode.color.fg}"
      },
      "accent": {
        "$type": "color",
        "$value": "{modify.displaymode.color.fg}"
      },
      "on-accent": {
        "$type": "color",
        "$value": "{modify.displaymode.color.bg}"
      }
    },
    "text": {
      "medium": {
        "$extensions": {
          "com.figma.scopes": [
            "FONT_FAMILY",
            "FONT_STYLE",
            "FONT_SIZE",
            "LINE_HEIGHT",
            "LETTER_SPACING"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "typography",
        "$value": {
          "fontFamily": "{input.font-family.inter}",
          "fontWeight": "{input.font-weight.bold}",
          "fontSize": "{input.number.24}",
          "lineHeight": "{input.line-height.normal}",
          "letterSpacing": "{input.number.0}"
        }
      },
      "small": {
        "$extensions": {
          "com.figma.scopes": [
            "FONT_FAMILY",
            "FONT_STYLE",
            "FONT_SIZE",
            "LINE_HEIGHT",
            "LETTER_SPACING"
          ],
          "com.figma.hiddenFromPublishing": false
        },
        "$type": "typography",
        "$value": {
          "fontFamily": "{input.font-family.inter}",
          "fontWeight": "{input.font-weight.medium}",
          "fontSize": "{input.number.12}",
          "lineHeight": "{input.line-height.normal}",
          "letterSpacing": "{input.number.0}"
        }
      }
    }
  }
}